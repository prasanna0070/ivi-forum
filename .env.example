# ivi-forum environment — copy to .env.local for dev. No secrets in code.

AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=               # https://<cloud-run-url> in prod; http://localhost:3000 in dev
AUTH_GOOGLE_ID=         # Google OAuth web client id (sign-in is Google only)
AUTH_GOOGLE_SECRET=     # its secret; redirect URI = $AUTH_URL/api/auth/callback/google

APIFY_API_TOKEN=
APIFY_LINKEDIN_PROFILE_ACTOR=apimaestro~linkedin-profile-batch-scraper-no-cookies-required

GCP_PROJECT=            # Firestore project (defaults to the ADC project if unset)
UPLOADS_BUCKET=         # private GCS bucket for forum image uploads (empty = image posting off)

ALLOWED_EMAIL_DOMAINS=  # optional, comma-separated (e.g. isb.edu); empty = open signup

SMTP_USER=              # Gmail sender, e.g. isbivico4@gmail.com (primary transport)
SMTP_PASS=              # its Gmail app password (needs 2-Step Verification on the account)
RESEND_API_KEY=         # fallback transport; with neither SMTP nor this, email stays dormant
EMAIL_FROM=             # SMTP: iVi Forum <isbivico4@gmail.com> (must match SMTP_USER); Resend: a verified domain
EMAIL_REPLY_TO=         # optional; a mailbox a human reads (helps deliverability into Microsoft 365)
